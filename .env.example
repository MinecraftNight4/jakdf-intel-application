# ---- Frontend (Vite lo mete en la web al construirla; es PUBLICO, no es un secreto) ----
VITE_DISCORD_CLIENT_ID=

# ---- Servidor (funciones de /api). En Vercel: Project Settings -> Environment Variables. NUNCA en el repositorio ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Opcional: token de SOLO LECTURA para las consultas de perfil (turso db tokens create <db> --read-only)
TURSO_READ_TOKEN=
